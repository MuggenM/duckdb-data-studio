# ==============================================================================
#                      DuckDB Studio Git Ignore Rules
# ==============================================================================

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
*.log

# --- Jupyter Notebooks ---
.ipynb_checkpoints/
.virtual_documents/
*/.ipynb_checkpoints/*

# --- DuckDB Databases & Write-Ahead Logs (WAL) ---
# Local database files can be large and are dynamically generated/seeded
*.duckdb
*.duckdb.wal
databases/*.duckdb
databases/*.duckdb.wal
ducklake/metadata.db

# --- Local Configurations & Environments ---
.env
.env.local
.env.development
.env.test
.env.production
!.env.example

# Per-environment attached databases and Jupyter config should remain local
config/attached_databases.yaml
config/studio_config.yaml

# --- Generated Data, Backups & Scratchpads ---
# Local parquet exports, backups, and temporary files
ducklake/data_parquet/
shared/db_backup_test/
shared/db_backup_sql_test/
shared/*.parquet
shared/*.txt
shared/untitled.txt

# --- NiceGUI State ---
.nicegui/

# --- OS Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Excluded Local Helper Files ---
optimize_gifs.py
create_missing_gifs.py
.antigravityignore
api_icon_transparent.png
.antigravitycli/
capture_screenshots.py
take_telemetry_screenshot.py
check_console_errors.py
create_analytics_dataset.py
create_explorer_gif.py
create_feature_traversal_gif.py
.venv_screenshot/
.vscode/

# --- Local Databases ---
config/*.db
config/*.db-wal
config/*.db-shm

# --- DBT targets & credentials ---
dbt_project/target/
profiles/.user.yml

# --- Temporary workspaces ---
scratch/
shared/garage/

# --- Local SSL Certs ---
config/certs/
